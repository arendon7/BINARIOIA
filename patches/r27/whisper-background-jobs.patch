--- a/hub/ui/hub.html
+++ b/hub/ui/hub.html
@@
-async function repairWhisper(){/* synchronous prepare */}
+async function pollWhisperJob(id){
+  for(let i=0;i<720;i++){
+    let j=await get('/api/whisper/job?job_id='+encodeURIComponent(id));
+    $('repairWhisperBtn').textContent='Whisper '+Math.round(Number(j.progress||0))+'%';
+    $('whisperHint').textContent=j.message||('Preparando Whisper · '+(j.stage||'runtime'));
+    if(j.status==='done')return j;
+    if(j.status==='failed')throw Error(j.error||j.result?.error||j.message||'Falló Whisper');
+    await new Promise(r=>setTimeout(r,1000));
+  }
+  throw Error('La preparación de Whisper no terminó dentro del tiempo esperado');
+}
+async function repairWhisper(){
+  let b=$('repairWhisperBtn');b.disabled=true;b.textContent='Iniciando Whisper…';
+  $('whisperHint').textContent='Whisper se prepara en segundo plano; puedes seguir usando las demás herramientas.';
+  try{
+    let start=await post('/api/whisper/job/start',{action:'prepare',model:'small'});
+    let job=await pollWhisperJob(start.job_id);
+    let state=await get('/api/whisper/status');setWhisper(state);
+    if(job.message)$('whisperHint').textContent=job.message;
+  }catch(e){setWhisper({ready:false,error:e.message})}finally{b.disabled=false}
+}
