+      const job=await apiJson(`/api/transcription/job?job_id=${encodeURIComponent(jobId)}`);
+      const btn=$("repairWhisperBtn"), box=$("whisperHealth"), small=box?.querySelector("small");
+      if(btn) btn.textContent=`Whisper ${Math.round(Number(job.progress||0))}%`;
+      if(small) small.textContent=job.message||`Preparando Whisper · ${job.stage||"runtime"}`;
+      if(job.status==="done") return job;
+      if(job.status==="failed") throw new Error(job.error||job.result?.error||job.message||"Falló Whisper");
+      await new Promise(resolve=>setTimeout(resolve,1000));
+    }
+    throw new Error("La preparación de Whisper no terminó dentro del tiempo esperado");
+  }
